# ==============================================================================
# Inventory Pro Environment Configuration
# ==============================================================================

# Server Port
PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (Aiven Cloud MySQL or Local Docker MySQL)
# ------------------------------------------------------------------------------
# For Aiven Cloud MySQL:
# 1. Sign up at https://aiven.io/ and create a free/trial MySQL service.
# 2. Copy the Service URI, Host, Port, User, and Password from the Overview tab.
# 3. Set DB_SSL_MODE=REQUIRED for Aiven.
DB_HOST=mysql-xxxx-project.aivencloud.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_SSL_MODE=REQUIRED

# For Local Docker MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=inventory_pro
# DB_USER=appuser
# DB_PASSWORD=secret
# DB_SSL_MODE=PREFERRED

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Use a 256-bit (or 512-bit) Hex or Base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Spring AI / OpenAI API Integration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
